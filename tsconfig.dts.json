// Declaration-only emit for the published package.
//
// Why this file exists: TypeScript 7.0 dropped the legacy JS compiler API
// (`ts.sys`, `ts.createProgram`, `ts.createSourceFile` are all undefined), so
// `tsup --dts` crashes — its rollup-plugin-dts step reads those internals.
// `tsc` itself emits declarations fine, so the build pipeline is now:
//   tsup (esbuild) -> dist/index.js + dist/index.cjs
//   tsc            -> dist/index.d.ts (copied to index.d.cts)
//
// The entrypoint and its imported public declarations are emitted together.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    // The published dist has never shipped .d.ts.map files; don't start now.
    "declarationMap": false,
    "outDir": "./dist"
  },
  // Only the package entrypoint and its declaration graph — never test scripts.
  "include": ["index.ts"]
}
